{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KV policy matrix v9",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "baseline",
    "required_comparators",
    "policies",
    "composition_policy",
    "required_tests",
    "snapshot_date"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "type": "string"
    },
    "baseline": {
      "type": "string"
    },
    "required_comparators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "evidence_status",
          "risks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "type": "string"
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "composition_policy": {
      "type": "object"
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    }
  }
}
