{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate profile inventory v9",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "snapshot_date",
    "global_constraints",
    "profiles"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "type": "string"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "global_constraints": {
      "type": "object"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose"
        ],
        "properties": {
          "id": {
            "enum": [
              "P0",
              "P1",
              "P1-LA",
              "P2",
              "P3",
              "P4",
              "P5",
              "P6",
              "P7",
              "P8",
              "P9"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "training_experiments": {
      "type": "array"
    }
  }
}
