{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric definitions v9",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_date",
    "status",
    "global_rules",
    "metrics"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string"
    },
    "global_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "unit",
          "measurement_method",
          "comparison_basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "measurement_method": {
            "type": "string",
            "minLength": 1
          },
          "comparison_basis": {
            "type": "string",
            "minLength": 1
          },
          "numerator": {
            "type": "string"
          },
          "denominator": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
